#
# recovery.fstab for vivo Y83 (PD1803, MT6765)
# Source: extracted from stock recovery ramdisk etc/recovery.fstab
# Format: TWRP-compatible (mountpoint fstype device [flags])
#
# MTK block layout - /dev/block/platform/bootdevice/by-name/* are
# created by the LK bootloader during recovery boot.

# ----------------------- Main partitions -----------------------
# System
/system         ext4    /dev/block/platform/bootdevice/by-name/system      flags=display="System";backup=1; wiping
# Vendor (treble)
/vendor         ext4    /dev/block/platform/bootdevice/by-name/vendor      flags=display="Vendor";backup=1; wiping
# Cust / OEM (carrier/operator customization, vivo-specific)
/oem            ext4    /dev/block/platform/bootdevice/by-name/cust        flags=display="Cust (OEM)";backup=1; wiping
# Cache
/cache          ext4    /dev/block/platform/bootdevice/by-name/cache        flags=display="Cache";backup=1; wipe
# Data (encrypted with file-based-key, forceencrypt in stock fstab)
/data           ext4    /dev/block/platform/bootdevice/by-name/userdata    flags=display="Data";backup=1;wipe;fsflags=block_validity;canencrypt;forceencrypt=/dev/block/platform/bootdevice/by-name/metadata

# ----------------------- Boot / Recovery -----------------------
/boot           emmc    /dev/block/platform/bootdevice/by-name/boot         flags=display="Boot";backup=1
/recovery       emmc    /dev/block/platform/bootdevice/by-name/recovery     flags=display="Recovery";backup=1

# ----------------------- Misc MTK partitions -----------------------
/persistent     emmc    /dev/block/platform/bootdevice/by-name/frp          flags=display="FRP";backup=1
/nvram          emmc    /dev/block/platform/bootdevice/by-name/nvram        flags=display="NVRAM";backup=1
/proinfo        emmc    /dev/block/platform/bootdevice/by-name/proinfo      flags=display="ProInfo";backup=1
/bootloader     emmc    /dev/block/platform/bootdevice/by-name/lk           flags=display="LK (bootloader)";backup=1
/bootloader2    emmc    /dev/block/platform/bootdevice/by-name/lk2          flags=display="LK2";backup=1
/misc           emmc    /dev/block/platform/bootdevice/by-name/para        flags=display="Misc"
/logo           emmc    /dev/block/platform/bootdevice/by-name/logo        flags=display="Logo";backup=1
/expdb          emmc    /dev/block/platform/bootdevice/by-name/expdb       flags=display="ExpDB"
/seccfg         emmc    /dev/block/platform/bootdevice/by-name/seccfg       flags=display="SecCfg";backup=1
/odmdtbo        emmc    /dev/block/platform/bootdevice/by-name/odmdtbo      flags=display="ODM-DTBO";backup=1
/tee1           emmc    /dev/block/platform/bootdevice/by-name/tee1         flags=display="TEE1";backup=1
/tee2           emmc    /dev/block/platform/bootdevice/by-name/tee2         flags=display="TEE2";backup=1
/scp1           emmc    /dev/block/platform/bootdevice/by-name/scp1         flags=display="SCP1";backup=1
/scp2           emmc    /dev/block/platform/bootdevice/by-name/scp2         flags=display="SCP2";backup=1
/sspm_1         emmc    /dev/block/platform/bootdevice/by-name/sspm_1      flags=display="SSPM_1";backup=1
/sspm_2         emmc    /dev/block/platform/bootdevice/by-name/sspm_2      flags=display="SSPM_2";backup=1
/efuse          emmc    /dev/block/platform/bootdevice/by-name/efuse        flags=display="EFuse"
/md1img         emmc    /dev/block/platform/bootdevice/by-name/md1img      flags=display="Modem Image";backup=1
/md1dsp         emmc    /dev/block/platform/bootdevice/by-name/md1dsp       flags=display="Modem DSP";backup=1
/md1arm7        emmc    /dev/block/platform/bootdevice/by-name/md1arm7     flags=display="MD1 ARM7";backup=1
/spmfw          emmc    /dev/block/platform/bootdevice/by-name/spmfw        flags=display="SPM Firmware";backup=1
/boot_para      emmc    /dev/block/platform/bootdevice/by-name/boot_para    flags=display="Boot Para"

# ----------------------- Protected partitions -----------------------
/vendor/protect_f  ext4   /dev/block/platform/bootdevice/by-name/protect1   flags=display="Protect_F";backup=1
/vendor/protect_s  ext4   /dev/block/platform/bootdevice/by-name/protect2   flags=display="Protect_S";backup=1
/vendor/nvdata     ext4   /dev/block/platform/bootdevice/by-name/nvdata     flags=display="NV Data";backup=1
/vendor/nvcfg      ext4   /dev/block/platform/bootdevice/by-name/nvcfg      flags=display="NV Config";backup=1
/vendor/persist    ext4   /dev/block/platform/bootdevice/by-name/persist    flags=display="Persist";backup=1

# ----------------------- Removable storage -----------------------
# External microSD card
/external_sd    auto    /devices/platform/externdevice*       auto            flags=voldmanaged=sdcard1:auto;format;fsflags=utf8;storage;notify
# USB OTG
/usb-otg        auto    /devices/platform/mt_usb*             auto            flags=voldmanaged=usbotg:auto;format;fsflags=utf8;storage;notify

# ----------------------- F2FS support -----------------------
/data           f2fs    /dev/block/platform/bootdevice/by-name/userdata    flags=display="Data (F2FS)";backup=1;wipe;canencrypt
